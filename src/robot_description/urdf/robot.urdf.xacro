<?xml version="1.0"?>

<robot
  name="simple_robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- =============================================== -->
  <!-- Configuration                                   -->
  <!-- =============================================== -->

  <xacro:arg name="config_file" default=""/>

  <xacro:property
    name="config"
    value="${xacro.load_yaml('$(arg config_file)')}"/>

  <xacro:property
    name="robot"
    value="${config['robot']}"/>


  <!-- =============================================== -->
  <!-- Components                                      -->
  <!-- =============================================== -->

  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="manipulator.xacro"/>
  <xacro:include filename="tracking_frame.xacro"/>
  <xacro:include filename="materials.xacro"/>


  <!-- =============================================== -->
  <!-- Robot assembly                                  -->
  <!-- =============================================== -->

  <xacro:robot_base robot="${robot}"/>

  <xacro:manipulator robot="${robot}"/>

  <xacro:tracking_frame robot="${robot}"/>



</robot>