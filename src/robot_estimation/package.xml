<?xml version="1.0"?>
<package format="3">

  <name>robot_estimation</name>

  <version>0.1.0</version>

  <description>
    State estimation package for the Adaptive Target Tracking Testbed.
  </description>

  <maintainer email="lior@example.com">
    Lior
  </maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>