  <maintainer email="liorshema@gmail.com">user</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>robot_bringup</exec_depend><exec_depend>robot_configuration</exec_depend>
  <exec_depend>robot_description</exec_depend><exec_depend>robot_models</exec_depend>
